# AgriSetu Environment Configuration Template
# Copy this file to .env and fill in your Supabase credentials.

# Supabase Project Public URL
EXPO_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co

# Supabase Anonymous Publishable Key (Safe for client app)
# DO NOT place the service_role secret key here!
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-publishable-key
